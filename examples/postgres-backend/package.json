{
  "name": "guardrails-postgres-backend-example",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24.22.1 <25" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "db:prepare": "npm run build && node dist/src/provision.js",
    "migrate": "npm run build && node dist/src/migrate.js",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.25",
    "@hono/node-server": "2.1.8",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "postgres": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": { "@types/node": "24.19.2", "typescript": "6.0.3" }
}
